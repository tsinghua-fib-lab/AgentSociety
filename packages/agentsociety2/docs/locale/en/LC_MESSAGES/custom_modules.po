#: ../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/custom_modules.rst:49
msgid ""
"所有自定义智能体必须继承 ``AgentBase``。智能体是 workspace 绑定的无状态 record：状态在 ``restore()`` 里恢复、在 "
"``to_workspace()`` 里写回；详见 :doc:`agents`。"
msgstr ""
"All custom agents must inherit from ``AgentBase``. Agents are workspace-bound "
"stateless records: state is restored in ``restore()`` and written back in "
"``to_workspace()``; see :doc:`agents`."

#: ../../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/custom_modules.rst:43
#, python-brace-format
msgid ""
"from pathlib import Path\n"
"from agentsociety2.agent.base import AgentBase\n"
"from datetime import datetime\n"
"from typing import Any\n"
"\n"
"class MyAgent(AgentBase):\n"
"    \"\"\"My custom Agent\"\"\"\n"
"\n"
"    @classmethod\n"
"    def description(cls) -> str:\n"
"        return \"MyAgent: A custom agent for specific tasks\"\n"
"\n"
"    async def restore(self, workspace_path: Path, service_proxy: Any) -> None:\n"
"        \"\"\"恢复 workspace / 服务 / 技能，再追加自定义状态。\"\"\"\n"
"        await super().restore(workspace_path, service_proxy)\n"
"        import json\n"
"        state_file = self.workspace_root_path() / \"state/custom.json\"\n"
"        self._custom_state = json.loads(state_file.read_text()) if state_file.exists() else {}\n"
"\n"
"    async def ask(self, message: str, readonly: bool = True, *, t=None) -> str:\n"
"        \"\"\"Respond to questions from the environment\"\"\"\n"
"        prompt = f\"Question: {message}\\nPlease answer:\"\n"
"        response = await self.acompletion([{\"role\": \"user\", \"content\": prompt}])\n"
"        return response.choices[0].message.content or \"\"\n"
"\n"
"    async def step(self, tick: int, t: datetime) -> str:\n"
"        \"\"\"Execute one simulation step\"\"\"\n"
"        self._current_time = t\n"
"        return f\"Agent {self.id} executing step {tick}\"\n"
"\n"
"    async def to_workspace(self, workspace_path: Path) -> None:\n"
"        \"\"\"把动态状态写回 workspace（AGENT.json 等）。\"\"\"\n"
"        import json\n"
"        from agentsociety2.storage.workspace_state import atomic_write_text\n"
"        atomic_write_text(\n"
"            self.workspace_root_path() / \"state/custom.json\",\n"
"            json.dumps(self._custom_state, ensure_ascii=False),\n"
"        )\n"
"        self.persist_agent_json(tick=None, t=self._current_time)"
msgstr ""
"from pathlib import Path\n"
"from agentsociety2.agent.base import AgentBase\n"
"from datetime import datetime\n"
"from typing import Any\n"
"\n"
"class MyAgent(AgentBase):\n"
"    \"\"\"My custom Agent\"\"\"\n"
"\n"
"    @classmethod\n"
"    def description(cls) -> str:\n"
"        return \"MyAgent: A custom agent for specific tasks\"\n"
"\n"
"    async def restore(self, workspace_path: Path, service_proxy: Any) -> None:\n"
"        \"\"\"Restore the workspace, services, and skills, then add custom state.\"\"\"\n"
"        await super().restore(workspace_path, service_proxy)\n"
"        import json\n"
"        state_file = self.workspace_root_path() / \"state/custom.json\"\n"
"        self._custom_state = json.loads(state_file.read_text()) if state_file.exists() else {}\n"
"\n"
"    async def ask(self, message: str, readonly: bool = True, *, t=None) -> str:\n"
"        \"\"\"Respond to questions from the environment\"\"\"\n"
"        prompt = f\"Question: {message}\\nPlease answer:\"\n"
"        response = await self.acompletion([{\"role\": \"user\", \"content\": prompt}])\n"
"        return response.choices[0].message.content or \"\"\n"
"\n"
"    async def step(self, tick: int, t: datetime) -> str:\n"
"        \"\"\"Execute one simulation step\"\"\"\n"
"        self._current_time = t\n"
"        return f\"Agent {self.id} executing step {tick}\"\n"
"\n"
"    async def to_workspace(self, workspace_path: Path) -> None:\n"
"        \"\"\"Write dynamic state back to the workspace, including AGENT.json.\"\"\"\n"
"        import json\n"
"        from agentsociety2.storage.workspace_state import atomic_write_text\n"
"        atomic_write_text(\n"
"            self.workspace_root_path() / \"state/custom.json\",\n"
"            json.dumps(self._custom_state, ensure_ascii=False),\n"
"        )\n"
"        self.persist_agent_json(tick=None, t=self._current_time)"

