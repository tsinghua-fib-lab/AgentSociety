#: ../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/custom_modules.rst:117
msgid "自定义环境必须继承 ``EnvBase`` 并使用 ``@tool`` 装饰器注册方法："
msgstr ""
"Custom environments must inherit from ``EnvBase`` and use the ``@tool`` decorator to "
"register methods:"

#: ../../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/custom_modules.rst:110
#, python-brace-format
msgid ""
"from agentsociety2.env import EnvBase, tool\n"
"from datetime import datetime\n"
"\n"
"class MyEnv(EnvBase):\n"
"    \"\"\"My custom environment\"\"\"\n"
"\n"
"    def __init__(self, config=None):\n"
"        super().__init__()\n"
"        # Initialize your environment state\n"
"\n"
"    @classmethod\n"
"    def description(cls) -> str:\n"
"        return \"MyEnv: A custom environment\"\n"
"\n"
"    @tool(readonly=True, kind=\"observe\")\n"
"    async def get_state(self, agent_id: int) -> dict:\n"
"        \"\"\"Get current environment state (observation tool)\"\"\"\n"
"        return {\"agent_id\": agent_id, \"state\": \"normal\"}\n"
"\n"
"    @tool(readonly=False)\n"
"    async def do_action(self, agent_id: int, action: str) -> dict:\n"
"        \"\"\"Perform an action (modification tool)\"\"\"\n"
"        return {\"agent_id\": agent_id, \"action\": action, \"result\": \"success\"}\n"
"\n"
"    async def step(self, tick: int, t: datetime):\n"
"        \"\"\"Environment step\"\"\"\n"
"        self.t = t\n"
"\n"
"    async def to_workspace(self, workspace_path=None) -> None:\n"
"        \"\"\"把动态状态写入 workspace；覆盖此方法可支持 resume，详见 :doc:`env_modules`。\"\"\"\n"
"        if workspace_path is not None:\n"
"            self._bind_workspace(workspace_path)\n"
"\n"
"    async def restore(self, workspace_path) -> bool:\n"
"        \"\"\"从 workspace 恢复动态状态；resume 时调用，默认返回 False。\"\"\"\n"
"        self._bind_workspace(workspace_path)\n"
"        return False"
msgstr ""
"from agentsociety2.env import EnvBase, tool\n"
"from datetime import datetime\n"
"\n"
"class MyEnv(EnvBase):\n"
"    \"\"\"My custom environment\"\"\"\n"
"\n"
"    def __init__(self, config=None):\n"
"        super().__init__()\n"
"        # Initialize your environment state\n"
"\n"
"    @classmethod\n"
"    def description(cls) -> str:\n"
"        return \"MyEnv: A custom environment\"\n"
"\n"
"    @tool(readonly=True, kind=\"observe\")\n"
"    async def get_state(self, agent_id: int) -> dict:\n"
"        \"\"\"Get current environment state (observation tool)\"\"\"\n"
"        return {\"agent_id\": agent_id, \"state\": \"normal\"}\n"
"\n"
"    @tool(readonly=False)\n"
"    async def do_action(self, agent_id: int, action: str) -> dict:\n"
"        \"\"\"Perform an action (modification tool)\"\"\"\n"
"        return {\"agent_id\": agent_id, \"action\": action, \"result\": \"success\"}\n"
"\n"
"    async def step(self, tick: int, t: datetime):\n"
"        \"\"\"Environment step\"\"\"\n"
"        self.t = t\n"
"\n"
"    async def to_workspace(self, workspace_path=None) -> None:\n"
"        \"\"\"Persist dynamic state to support resume; see :doc:`env_modules`.\"\"\"\n"
"        if workspace_path is not None:\n"
"            self._bind_workspace(workspace_path)\n"
"\n"
"    async def restore(self, workspace_path) -> bool:\n"
"        \"\"\"Restore dynamic state from the workspace; called on resume, returns False by "
"default.\"\"\"\n"
"        self._bind_workspace(workspace_path)\n"
"        return False"

