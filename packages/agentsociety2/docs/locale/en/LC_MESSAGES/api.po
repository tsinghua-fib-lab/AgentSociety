#: agentsociety2.agent.base.agent.AgentBase:1 of
msgid "所有 agent 的抽象基类。"
msgstr "Abstract base class for all agents."

#: agentsociety2.agent.base.agent.AgentBase:3 of
msgid ""
"直接持有通用 agent 运行时(workspace 绑定、skill runtime、ReAct 工具分发),外加 identity、service 槽位与抽象契约。构造经由 "
"``create`` / ``from_workspace``;``__init__`` 无参。"
msgstr ""
"Directly owns the generic agent runtime (workspace binding, skill runtime, ReAct tool dispatch), "
"plus identity, service slots, and the abstract contract. Construction is via ``create`` / "
"``from_workspace``; ``__init__`` is arg-less."

#: agentsociety2.agent.base.agent.AgentBase:7 of
msgid "子类必须实现(强制抽象方法):"
msgstr "Subclasses must implement (forced abstracts):"

#: agentsociety2.agent.base.agent.AgentBase:9 of
msgid ":meth:`create`"
msgstr ":meth:`create`"

#: agentsociety2.agent.base.agent.AgentBase:10 of
msgid ":meth:`from_workspace`"
msgstr ":meth:`from_workspace`"

#: agentsociety2.agent.base.agent.AgentBase:11 of
msgid ":meth:`to_workspace`"
msgstr ":meth:`to_workspace`"

#: agentsociety2.agent.base.agent.AgentBase:12 of
msgid ":meth:`ask`"
msgstr ":meth:`ask`"

