#: ../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/api/env.rst:7
msgid "RouterBase"
msgstr "RouterBase"

#: agentsociety2.env.router_base.RouterBase:1 of
msgid "环境路由器抽象基类。"
msgstr "Environment router abstract base class."

#: agentsociety2.env.router_base.RouterBase:3 of
msgid "Router 用于协调 agent 与环境模块（:class:`~agentsociety2.env.base.EnvBase` ）的交互，职责包括："
msgstr ""
"Router is used to coordinate the interaction between the agent and the environment "
"module (:class:`~agentsociety2.env.base.EnvBase`). Its responsibilities include:"

#: agentsociety2.env.router_base.RouterBase:5 of
msgid "聚合并过滤环境工具（函数调用 schema）"
msgstr "Aggregate and filter environment tools (function call schema)"

#: agentsociety2.env.router_base.RouterBase:6 of
msgid "接收编排器推送的仿真时钟（:meth:`set_current_time` ），供 env 模块在 agent 阶段读取"
msgstr ""
"Receive the simulation clock pushed by the orchestrator (:meth:`set_current_time`) so"
" env modules can read it during the agent phase."

#: agentsociety2.env.router_base.RouterBase:7 of
msgid "提供统一 LLM 调用封装（重试）"
msgstr "Provide unified LLM call encapsulation (retry and token statistics)"

#: agentsociety2.env.router_base.RouterBase:8 of
msgid "生成 world description（可选，用于 PersonAgent 的提示词）"
msgstr "Generate world description (optional, used as the prompt for PersonAgent)"

#: agentsociety2.env.router_base.RouterBase.__init__:1
#: agentsociety2.env.router_codegen.CodeGenRouter.__init__:1
#: agentsociety2.env.router_plan_execute.PlanExecuteRouter.__init__:1
#: agentsociety2.env.router_react.ReActRouter.__init__:1
#: agentsociety2.env.router_search_tool.SearchToolRouter.__init__:1
#: agentsociety2.env.router_two_tier_plan_execute.TwoTierPlanExecuteRouter.__init__:1
#: agentsociety2.env.router_two_tier_react.TwoTierReActRouter.__init__:1 of
msgid "创建路由器实例。"
msgstr "Create a router instance."

#: agentsociety2.env.router_base.RouterBase.__init__:3
#: agentsociety2.env.router_codegen.CodeGenRouter.__init__:3
#: agentsociety2.env.router_plan_execute.PlanExecuteRouter.__init__:3
