"**analysis**: data analysis tooling, providing experiment context loading, EDA, and "
"tool registration capabilities"

#: agentsociety2.skills:14 of
msgid "使用示例"
msgstr "Usage Example"

#: agentsociety2.skills:16 of
msgid ""
"from pathlib import Path\n"
"\n"
"from agentsociety2.skills import analysis, hypothesis, literature\n"
"\n"
"# 文献检索\n"
"results = await literature.search_literature(\"machine learning\")\n"
"\n"
"# 创建假设\n"
"hypothesis.add_hypothesis(\n"
"    workspace_path=Path(\"./workspace\"),\n"
"    hypothesis=\"社会网络密度影响信息传播速度\"\n"
")\n"
"\n"
"# 读取实验 replay catalog\n"
"from agentsociety2.storage import ReplayReader\n"
"\n"
"reader = ReplayReader(Path(\"./workspace/hypothesis_1/experiment_1/run/replay\"))\n"
"datasets = reader.load_dataset_catalog()\n"
"reader.close()"
msgstr ""
"from pathlib import Path\n"
"\n"
"from agentsociety2.skills import analysis, hypothesis, literature\n"
"\n"
"# Search literature\n"
"results = await literature.search_literature(\"machine learning\")\n"
"\n"
"# Create a hypothesis\n"
"hypothesis.add_hypothesis(\n"
"    workspace_path=Path(\"./workspace\"),\n"
"    hypothesis=\"Social network density affects information propagation speed\"\n"
")\n"
"\n"
"# Read the experiment replay catalog\n"
"from agentsociety2.storage import ReplayReader\n"
"\n"
"reader = ReplayReader(Path(\"./workspace/hypothesis_1/experiment_1/run/replay\"))\n"
"datasets = reader.load_dataset_catalog()\n"
"reader.close()"

