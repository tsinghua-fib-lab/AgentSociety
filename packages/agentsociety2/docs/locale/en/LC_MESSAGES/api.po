#: agentsociety2.env.router_two_tier_react.TwoTierReActRouter.__init__:3 of
msgid "环境模块列表。"
msgstr "List of environment modules."

#: agentsociety2.env.router_base.RouterBase.__init__:4
#: agentsociety2.env.router_codegen.CodeGenRouter.__init__:4
#: agentsociety2.env.router_plan_execute.PlanExecuteRouter.__init__:4
#: agentsociety2.env.router_react.ReActRouter.__init__:4
#: agentsociety2.env.router_search_tool.SearchToolRouter.__init__:4
#: agentsociety2.env.router_two_tier_plan_execute.TwoTierPlanExecuteRouter.__init__:4
#: agentsociety2.env.router_two_tier_react.TwoTierReActRouter.__init__:4 of
msgid "最大执行步数（由具体 router 实现解释）。"
msgstr "Maximum number of execution steps (interpreted by specific router implementation)."

#: agentsociety2.env.router_base.RouterBase.__init__:5
#: agentsociety2.env.router_codegen.CodeGenRouter.__init__:5
#: agentsociety2.env.router_plan_execute.PlanExecuteRouter.__init__:5
#: agentsociety2.env.router_react.ReActRouter.__init__:5
#: agentsociety2.env.router_search_tool.SearchToolRouter.__init__:5
#: agentsociety2.env.router_two_tier_plan_execute.TwoTierPlanExecuteRouter.__init__:5
#: agentsociety2.env.router_two_tier_react.TwoTierReActRouter.__init__:5 of
msgid "LLM 调用最大重试次数下限（至少为 1）。"
msgstr "Lower limit on the maximum number of retries for LLM calls (at least 1)."

#: agentsociety2.env.router_base.RouterBase.__init__:6
#: agentsociety2.env.router_codegen.CodeGenRouter.__init__:6
#: agentsociety2.env.router_plan_execute.PlanExecuteRouter.__init__:6
#: agentsociety2.env.router_react.ReActRouter.__init__:6
