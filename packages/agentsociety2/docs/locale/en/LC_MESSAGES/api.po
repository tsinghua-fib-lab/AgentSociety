msgstr "Semantic metadata for a replay dataset stored as sharded JSONL tables."

#: ../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/api/storage.rst:32
msgid "ReplayReader"
msgstr "ReplayWriter"

#: agentsociety2.storage.replay_reader.ReplayReader:1 of
