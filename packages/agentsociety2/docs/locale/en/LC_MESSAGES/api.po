#: agentsociety2.agent.base.agent.AgentBase.restore:1 of
msgid "真正的初始化(由 ``from_workspace`` 调用)。"
msgstr "The real initialization (called by ``from_workspace``)."

#: agentsociety2.agent.base.agent.AgentBase.restore:3 of
msgid ""
"读取 ``config.json`` + ``AGENT.json``;设置 ``_id``/``_profile``/ ``_name``/``_config``;调用"
" ``_bind_services`` + ``_bind_workspace``; 恢复 visible/activated skills 与计数器。"
msgstr ""
"Reads ``config.json`` + ``AGENT.json``; sets ``_id``/``_profile``/ "
"``_name``/``_config``; calls ``_bind_services`` + ``_bind_workspace``; restores "
"visible/activated skills and counters."

#: agentsociety2.agent.base.agent.AgentBase.restore:7 of
msgid "子类可覆写本方法,在 ``await super().restore(...)`` 之后**同时**恢复 person 专属状态。"
msgstr ""
"Subclasses may override this to ALSO restore person-specific state after ``await "
"super().restore(...)``."

#: agentsociety2.agent.base.agent.AgentBase.restore:11
#: agentsociety2.agent.person.PersonAgent.restore:4 of
msgid "共享服务容器。"
msgstr "Shared service container."

#: agentsociety2.agent.base.agent.AgentBase.to_workspace:1 of
