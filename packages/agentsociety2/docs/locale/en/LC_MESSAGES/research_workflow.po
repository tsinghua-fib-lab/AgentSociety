#: ../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/research_workflow.rst:43
msgid "配置仿真"
msgstr "Configure simulations"

#: ../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/research_workflow.rst:44
msgid "数据到画像或状态的映射、模块参数与执行步骤"
msgstr "Mapping data to profiles or state, module parameters, and execution steps"

#: ../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/research_workflow.rst:45
msgid "``init/init_config.json``、``init/steps.yaml``"
msgstr "``init/init_config.json``, ``init/steps.yaml``"

#: ../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/research_workflow.rst:46
msgid "执行实验"
msgstr "Run experiments"

#: ../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/research_workflow.rst:47
msgid "运行状态、失败步骤、数据是否写出"
msgstr "Run status, failed steps, and whether data was written"

#: ../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/research_workflow.rst:48
msgid "``run/pid.json``、``run/output.log``、``run/replay/``"
msgstr "``run/pid.json``, ``run/output.log``, ``run/replay/``"

