#: ../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/user_guide.rst:394
msgid "工作区目录结构"
msgstr "Workspace Directory Structure"

#: ../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/user_guide.rst:396
msgid "随着研究推进，工作区会按需形成以下结构；初始化只创建基础目录，实验和报告在后续流程生成："
msgstr ""
"As research progresses, the workspace acquires the following structure as needed. "
"Initialization creates only the base directories; experiments and reports are "
"generated later:"

#: ../../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/user_guide/research-project.rst:34
msgid ""
"工作区/\n"
"├── TOPIC.md                          # 研究叙事中心文档\n"
"├── .env                              # 环境配置\n"
"├── papers/\n"
"│   ├── literature_index.json         # 文献索引\n"
"│   ├── <title>_<timestamp>.md        # 文献笔记\n"
"│   └── full_texts/                   # 全文 PDF（如有）\n"
"├── user_data/                        # 用户数据\n"
"├── datasets/                         # 数据集\n"
"├── hypothesis_1/\n"
"│   ├── HYPOTHESIS.md                 # 假设描述\n"
"│   ├── SIM_SETTINGS.json             # 模块配置\n"
"│   ├── experiment_1/                 # 实验 1（对照组）\n"
"│   │   ├── init/\n"
"│   │   │   ├── init_config.json      # 智能体与环境配置\n"
"│   │   │   └── steps.yaml            # 仿真步骤\n"
"│   │   └── run/                      # 运行产出\n"
"│   └── experiment_2/                 # 实验 2（处理组）\n"
"├── presentation/                     # 分析报告\n"
"│   └── hypothesis_1/\n"
"│       ├── report_zh.md\n"
"│       ├── report_zh.html\n"
"│       ├── report_en.md\n"
"│       ├── report_en.html\n"
"│       └── charts/\n"
"├── synthesis/                        # 综合报告\n"
"├── paper/                            # 外部论文工具链产物\n"
"└── custom/                           # 自定义模块\n"
"    ├── agents/\n"
"    ├── envs/\n"
"    └── skills/"
msgstr ""
"workspace/\n"
"├── TOPIC.md                          # Central research narrative\n"
"├── .env                              # Environment configuration\n"
"├── papers/\n"
"│   ├── literature_index.json         # Literature index\n"
"│   ├── <title>_<timestamp>.md        # Literature notes\n"
"│   └── full_texts/                   # Full-text PDFs when available\n"
"├── user_data/                        # User data\n"
"├── datasets/                         # Datasets\n"
"├── hypothesis_1/\n"
"│   ├── HYPOTHESIS.md                 # Hypothesis description\n"
"│   ├── SIM_SETTINGS.json             # Module configuration\n"
"│   ├── experiment_1/                 # Experiment 1, control group\n"
"│   │   ├── init/\n"
"│   │   │   ├── init_config.json      # Agent and environment configuration\n"
"│   │   │   └── steps.yaml            # Simulation steps\n"
"│   │   └── run/                      # Run outputs\n"
"│   └── experiment_2/                 # Experiment 2, treatment group\n"
"├── presentation/                     # Analysis reports\n"
"│   └── hypothesis_1/\n"
"│       ├── report_zh.md\n"
"│       ├── report_zh.html\n"
"│       ├── report_en.md\n"
"│       ├── report_en.html\n"
"│       └── charts/\n"
"├── synthesis/                        # Synthesis reports\n"
"├── paper/                            # External paper toolkit artifacts\n"
"└── custom/                           # Custom modules\n"
"    ├── agents/\n"
"    ├── envs/\n"
"    └── skills/"

