#: ../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/cli.rst:295
msgid "示例：完整工作流"
msgstr "Example: Complete Workflow"

#: ../../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/cli.rst:294
msgid ""
"# 1. 准备配置文件\n"
"mkdir -p my_experiment/init my_experiment/run\n"
"# ... 创建 init_config.json 和 steps.yaml ...\n"
"\n"
"# 2. 前台测试运行\n"
"python -m agentsociety2.society.cli \\\n"
"    --config my_experiment/init/init_config.json \\\n"
"    --steps my_experiment/init/steps.yaml \\\n"
"    --run-dir my_experiment/run \\\n"
"    --log-level DEBUG\n"
"\n"
"# 3. 后台生产运行\n"
"python -m agentsociety2.society.cli \\\n"
"    --config my_experiment/init/init_config.json \\\n"
"    --steps my_experiment/init/steps.yaml \\\n"
"    --run-dir my_experiment/run \\\n"
"    --experiment-id \"exp_001\" \\\n"
"    --log-level INFO \\\n"
"    --log-file my_experiment/run/output.log &\n"
"\n"
"# 4. 监控运行\n"
"tail -f my_experiment/run/output.log\n"
"\n"
"# 5. 完成后检查 replay catalog\n"
"python - <<'PY'\n"
"from agentsociety2.storage import ReplayReader\n"
"reader = ReplayReader(\"my_experiment/run/replay\")\n"
"print([d[\"dataset_id\"] for d in reader.load_dataset_catalog()])\n"
"reader.close()\n"
"PY"
msgstr ""
"# 1. Prepare configuration files\n"
"mkdir -p my_experiment/init my_experiment/run\n"
"# ... create init_config.json and steps.yaml ...\n"
"\n"
"# 2. Test in the foreground\n"
"python -m agentsociety2.society.cli \\\n"
"    --config my_experiment/init/init_config.json \\\n"
"    --steps my_experiment/init/steps.yaml \\\n"
"    --run-dir my_experiment/run \\\n"
"    --log-level DEBUG\n"
"\n"
"# 3. Run in the background\n"
"python -m agentsociety2.society.cli \\\n"
"    --config my_experiment/init/init_config.json \\\n"
"    --steps my_experiment/init/steps.yaml \\\n"
"    --run-dir my_experiment/run \\\n"
"    --experiment-id \"exp_001\" \\\n"
"    --log-level INFO \\\n"
"    --log-file my_experiment/run/output.log &\n"
"\n"
"# 4. Monitor the run\n"
"tail -f my_experiment/run/output.log\n"
"\n"
"# 5. Inspect the replay catalog after completion\n"
"python - <<'PY'\n"
"from agentsociety2.storage import ReplayReader\n"
"reader = ReplayReader(\"my_experiment/run/replay\")\n"
"print([d[\"dataset_id\"] for d in reader.load_dataset_catalog()])\n"
"reader.close()\n"
"PY"
