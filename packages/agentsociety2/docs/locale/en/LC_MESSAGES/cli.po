"├── replay/               # _schema.json + sharded JSONL replay datasets\n"
"├── trace/                # sharded JSONL trace spans\n"
"├── SOCIETY.json          # Initialization checkpoint\n"
"├── SOCIETY_STEP.json     # Most recently completed step checkpoint\n"
"├── env/                  # Environment module state\n"
"├── agents/               # agent workspaces\n"
"└── artifacts/            # ask / intervene / questionnaire artifacts\n"
"    ├── ask_step_0_<timestamp>.md\n"
"    ├── intervene_step_2_<timestamp>.md\n"
"    └── ..."

