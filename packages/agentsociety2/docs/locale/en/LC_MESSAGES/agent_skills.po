#: ../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/agent_skills.rst:396
msgid "``scripts/hello_skill.py``（``entrypoint`` + CLI 共用派发）："
msgstr "``scripts/hello_skill.py``:"

#: ../../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/agent_skills.rst:375
#, python-brace-format
msgid ""
"import contextvars\n"
"import json\n"
"from pathlib import Path\n"
"from typing import Any\n"
"\n"
"_WORKSPACE_ROOT: contextvars.ContextVar[Path | None] = contextvars.ContextVar(\n"
"    \"hello_workspace_root\", default=None\n"
")\n"
"\n"
"def entrypoint(argv: list[str], ctx: Any) -> str:\n"
"    root = Path(str(getattr(ctx, \"workspace_root\"))).resolve()\n"
"    _WORKSPACE_ROOT.set(root)\n"
"    (root / \"hello.txt\").write_text(\"hello-skill: greeted\", encoding=\"utf-8\")\n"
"    return json.dumps({\"ok\": True, \"summary\": \"greeted\"}, ensure_ascii=False)\n"
"\n"
"if __name__ == \"__main__\":\n"
"    # 手动 CLI 运行仍可用（运行时经 skill_worker.py 调用 entrypoint）\n"
"    raise SystemExit(0 if entrypoint([], type(\"C\", (), {\"workspace_root\": \".\"})()) else 1)"
msgstr ""
"import contextvars\n"
"import json\n"
"from pathlib import Path\n"
"from typing import Any\n"
"\n"
"_WORKSPACE_ROOT: contextvars.ContextVar[Path | None] = contextvars.ContextVar(\n"
"    \"hello_workspace_root\", default=None\n"
")\n"
"\n"
"def entrypoint(argv: list[str], ctx: Any) -> str:\n"
"    root = Path(str(getattr(ctx, \"workspace_root\"))).resolve()\n"
"    _WORKSPACE_ROOT.set(root)\n"
"    (root / \"hello.txt\").write_text(\"hello-skill: greeted\", encoding=\"utf-8\")\n"
"    return json.dumps({\"ok\": True, \"summary\": \"greeted\"}, ensure_ascii=False)\n"
"\n"
"if __name__ == \"__main__\":\n"
"    # Manual CLI execution remains available; the runtime calls entrypoint through "
"skill_worker.py\n"
"    raise SystemExit(0 if entrypoint([], type(\"C\", (), {\"workspace_root\": \".\"})()) else 1)"

