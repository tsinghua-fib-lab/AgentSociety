#: ../../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/examples.rst:7
msgid "先离线检查配置"
msgstr "Validate configuration offline first"

#: ../../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/examples.rst:9
msgid "下面的示例验证初始化配置和时间步参数，不启动 Ray 或调用模型。配置校验能发现缺失字段和无效步数；模块是否可用、模型能否连接仍需运行时检查。"
msgstr ""
"This example validates initialization configuration and time-step parameters without starting Ray"
" or calling a model. Validation catches missing fields and invalid step counts; module "
"availability and model connectivity still require runtime checks."

#: ../../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/examples.rst:11
#, python-brace-format
msgid ""
"from pydantic import ValidationError\n"
"from agentsociety2.society import InitConfig, RunStep\n"
"\n"
"config = InitConfig.model_validate({\n"
"    \"env_modules\": [{\"module_type\": \"SimpleSocialSpace\"}],\n"
"    \"agents\": [{\n"
"        \"agent_id\": 1,\n"
"        \"agent_type\": \"PersonAgent\",\n"
"        \"kwargs\": {\"id\": 1, \"profile\": {\"name\": \"Alice\"}},\n"
"    }],\n"
"})\n"
"step = RunStep(num_steps=2, tick=600)\n"
"assert config.agents[0].kwargs[\"id\"] == 1\n"
"assert step.num_steps * step.tick == 1200\n"
"try:\n"
"    RunStep(num_steps=0)\n"
"except ValidationError:\n"
"    print(\"Invalid step count rejected.\")\n"
"else:\n"
"    raise AssertionError(\"Expected a validation error\")"
msgstr ""
"from pydantic import ValidationError\n"
"from agentsociety2.society import InitConfig, RunStep\n"
"\n"
"config = InitConfig.model_validate({\n"
"    \"env_modules\": [{\"module_type\": \"SimpleSocialSpace\"}],\n"
"    \"agents\": [{\n"
"        \"agent_id\": 1,\n"
"        \"agent_type\": \"PersonAgent\",\n"
"        \"kwargs\": {\"id\": 1, \"profile\": {\"name\": \"Alice\"}},\n"
"    }],\n"
"})\n"
"step = RunStep(num_steps=2, tick=600)\n"
"assert config.agents[0].kwargs[\"id\"] == 1\n"
"assert step.num_steps * step.tick == 1200\n"
"try:\n"
"    RunStep(num_steps=0)\n"
"except ValidationError:\n"
"    print(\"Invalid step count rejected.\")\n"
"else:\n"
"    raise AssertionError(\"Expected a validation error\")"

