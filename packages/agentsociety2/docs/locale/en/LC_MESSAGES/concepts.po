"    \"\"\"Get average happiness of all agents.\"\"\"\n"
"    avg = sum(self.happiness.values()) / len(self.happiness)\n"
"    return f\"Average happiness: {avg}\""

#: ../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/concepts.rst:251
