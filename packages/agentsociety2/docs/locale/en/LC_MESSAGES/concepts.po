msgstr ""
"@tool(readonly=True, kind=\"observe\")\n"
"def get_agent_location(self, agent_id: int) -> str:\n"
"    \"\"\"Get current location of agent.\"\"\"\n"
"    return f\"Agent {agent_id} is at location X\""

#: ../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/concepts.rst:239
msgid "**统计工具** (``readonly=True``, ``kind=\"statistics\"``)"
msgstr "**Statistics Tools** (``readonly=True``, ``kind=\"statistics\"``)"

#: ../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/concepts.rst:241
msgid "没有参数的聚合查询（除了 ``self``）："
msgstr "Aggregate queries with no parameters (except ``self``):"

#: ../../../data2/home/huanghaoyu/AgentSociety/agentsociety2/agentsociety/packages/agentsociety2/docs/concepts.rst:229
