msgid ""
"@tool(readonly=True, kind=\"statistics\")\n"
"def get_average_happiness(self) -> str:\n"
"    \"\"\"Get average happiness of all agents.\"\"\"\n"
"    avg = sum(self.happiness.values()) / len(self.happiness)\n"
