# ============================================================
# LLM 配置（必需）
# ============================================================
# 默认大语言模型配置，作为所有其他 LLM 配置的回退选项
AGENTSOCIETY_LLM_API_KEY=your_api_key
AGENTSOCIETY_LLM_API_BASE=https://api.openai.com/v1
AGENTSOCIETY_LLM_MODEL=gpt-5.5

# ============================================================
# Coder LLM 配置（可选）
# ============================================================
# 用于代码生成的专用模型，如未设置则回退到默认 LLM 配置
AGENTSOCIETY_CODER_LLM_API_KEY=your_coder_api_key
AGENTSOCIETY_CODER_LLM_API_BASE=https://api.openai.com/v1
AGENTSOCIETY_CODER_LLM_MODEL=gpt-5.5

# ============================================================
# 推理（thinking）开关（可选，仅 OpenAI 兼容 chat-completions 接口）
# ============================================================
# 留空 = 不发送任何新参数，行为与不启用该功能时完全一致。
# 取值 on / off（兼容 1/0/true/false）。
AGENTSOCIETY_LLM_THINKING=

# off 时发送的 reasoning_effort（缺省 "minimal"）；on 时仅在显式设置后才发送。
AGENTSOCIETY_LLM_REASONING_EFFORT=

# 网关私有的 OpenAI 兼容开关，JSON 对象字符串，合并进请求的 extra_body。
# 配了它时 off 只发 extra_body、不发 reasoning_effort（避免网关同时收到两个开关而报错）。
# 例：{"enable_thinking": false} / {"thinking": {"type": "disabled"}}
AGENTSOCIETY_LLM_EXTRA_BODY=

# coder 角色（env router 代码生成）覆盖，未设时回退到上面三项。
AGENTSOCIETY_CODER_LLM_THINKING=
AGENTSOCIETY_CODER_LLM_REASONING_EFFORT=
AGENTSOCIETY_CODER_LLM_EXTRA_BODY=

# ============================================================
# Embedding 模型配置（可选）
# ============================================================
# 文本嵌入模型，用于向量化文本，如未设置则回退到默认 LLM 配置
AGENTSOCIETY_EMBEDDING_API_KEY=your_embedding_api_key
AGENTSOCIETY_EMBEDDING_API_BASE=https://api.openai.com/v1
AGENTSOCIETY_EMBEDDING_MODEL=text-embedding-3-large
AGENTSOCIETY_EMBEDDING_DIMS=1024

# ============================================================
# 后端服务配置
# ============================================================
BACKEND_HOST=127.0.0.1
# 外部部署时显式设置可信 Host（逗号分隔）；后端本身不提供身份认证。
BACKEND_TRUSTED_HOSTS=
# 跨域网页访问需要显式列出可信 Origin（逗号分隔的完整 URL）。
BACKEND_ALLOWED_ORIGINS=
BACKEND_PORT=8001

# CodeGen 生成代码执行超时（秒，默认 10）。
AGENTSOCIETY_CODE_EXEC_TIMEOUT=10

# ============================================================
# 工作区路径
# ============================================================
# 自定义模块的工作区根目录（custom/ 文件夹所在位置）
WORKSPACE_PATH=/path/to/workspace

# ============================================================
# 外部 API 配置
# ============================================================

# 学术文献检索服务
LITERATURE_SEARCH_MCP_URL=https://llmapi.fiblab.net/mcp/
LITERATURE_SEARCH_API_KEY=your-literature-search-key
